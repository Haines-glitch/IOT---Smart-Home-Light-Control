# =================================================================
# Environment Configuration Template
# Copy this file to .env and replace placeholders with real credentials.
# NEVER commit your actual .env file with secrets to Git.
# =================================================================

# PostgreSQL Database Connection String
# For Render: Copy the "Internal Database URL" (if backend & DB are on Render)
# or "External Database URL" from your Render PostgreSQL instance.
# Example: postgresql://smart_home_user:StrongPassword@dpg-xxxx.render.com:5432/smart_home_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Shared Secret Key between ESP32 and Backend
# Generate a secure 32+ character random string (e.g. openssl rand -hex 32)
# ESP32 will send this in the "X-Device-Key" header.
DEVICE_API_KEY=replace-with-a-long-random-secret

# Application Port (Render will set this automatically in production)
PORT=8000
